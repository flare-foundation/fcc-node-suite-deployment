# Copy this file to terraform.tfvars and fill in the values for your own GCP project.

project = "my-gcp-project"

# An existing service account in `project` with (at minimum):
#   roles/iam.serviceAccountUser
#   roles/secretmanager.admin
#   roles/cloudsql.admin
#   roles/storage.admin
#   roles/redis.admin
#   roles/compute.instanceAdmin.v1
#   roles/confidentialcomputing.workloadUser (required for tee-machine to run as a
#     Confidential Space workload at all)
# The images below are public (GHCR), so no extra registry access is needed
# for them. If you use an image from a private registry instead, granting
# this service account access to it is on you.
service_account_email = "my-service-account@my-gcp-project.iam.gserviceaccount.com"

# The tee-machine workload image
tee_node_docker_image = "ghcr.io/flare-foundation/tee-node:v0.0.24"

# The tee-proxy image
tee_proxy_docker_image = "ghcr.io/flare-foundation/tee-proxy:v0.0.24"

# tee-proxy's signing private key: a secp256k1 private key as a 0x-prefixed
# hex string. Generate a fresh one with ../../scripts/generate-key.sh.
tee_proxy_private_key = "0x..."
