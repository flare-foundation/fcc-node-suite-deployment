redis_port = "${redis_host}:${redis_port}"

chain_id = ${chain_id}
private_key_variable = "PRIVATE_KEY"

# "indexer" reads [db]; "rpc" reads the C-chain node in the NODE_URL env var
# (and NODE_API_KEY), which the systemd unit passes from its 0600 env file.
[chain]
source = "${chain_source}"
%{ if chain_source == "indexer" }
[db]
host = "${indexer_host}"
port = ${indexer_port}
database = "${indexer_database_name}"
username = "${indexer_database_user}"
password = "${indexer_database_password}"
log_queries = false
%{ endif }
[addresses]
flare_systems_manager = "${flare_systems_manager}"
relay = "${relay}"
voter_registry = "${voter_registry}"
machine_path_manager = "${machine_path_manager}"

[ports]
internal = "${internal_port}"
external = "${external_port}"

[info_timing]
cycle_internal = "60s"
cycle_queue_response_wait = "2s"

[voting]
# Also the signing policy depth since tee-proxy v0.0.25: a fresh start
# initializes history_size - 1 epochs back. Replaces the removed
# initial_signing_policy_offset, which v0.0.25 rejects at boot.
history_size = 3
proposal_expiration = "120s"
max_pending_request = 100

[gcs]
bucket = "${gcs_bucket}"
prefix = "${gcs_prefix}"
url = ""
credentials_file = ""
%{ if direct_api_key != "" }

[direct]
# POST /direct, used by extensions that take actions off-chain rather than as
# on-chain instructions - the USDX oracle uses it for SET_SECRET and
# GET_READINESS. The key itself is passed as the DIRECT_API_KEY env var rather
# than written here, same as the signing key.
enable = true
api_key_variable = "DIRECT_API_KEY"
api_key_optional = false
%{ endif }
%{ if length(governance_signers) > 0 }
# Keep this last - it is a TOML table, so any key written below it would be
# parsed as part of it. Emitted only when governance is configured: an unset
# [governance] is valid and means direct-signature governance, where tee-proxy
# recovers the on-chain signatures itself.
[governance]
signers = [${join(", ", formatlist("\"%s\"", governance_signers))}]
threshold = ${governance_threshold}
%{ if governance_safe != "" }
safe = "${governance_safe}"
tee_manager = "${governance_tee_manager}"
%{ endif }
%{ endif }
