[db]
host = "${db_host}"
port = 3306
database = "indexer"
username = "${db_user}"
password = "${db_pass}"
log_queries = false
drop_table_at_start = ${drop_table_at_start}
%{ if history_drop_seconds != null }
history_drop = ${history_drop_seconds}
%{ endif }

[logger]
level = "INFO"
console = true

[chain]
node_url = "${chain_rpc_endpoint}"

[indexer]
start_index = ${start_index}
batch_size = 1000
rpc_concurrency = 10
# Max blocks per eth_getLogs call. Public Flare RPC endpoints cap that range
# at 30, and going over it makes log collection back off forever without ever
# persisting a first indexer state row. Point this at whatever your node's cap
# is; on a dedicated node 1000+ is normal.
#
# In v2 batch_size, log_range and rpc_concurrency are independent knobs - the
# 1.x requirement that they divide evenly (an uneven split silently dropped
# each batch's tail blocks from log collection) is gone.
log_range = 25

[[indexer.collect_transactions]]
contract_address = "${flare_systems_manager}"
func_sig = "6b4c7bd6"
status = true

[[indexer.collect_transactions]]
contract_address = "${voter_registry}"
func_sig = "8f7d0957"
status = true

[[indexer.collect_logs]]
contract_address = "${relay}"
topic = "0x91d0280e969157fc6c5b8f952f237b03d934b18534dafcac839075bbc33522f8"

[[indexer.collect_logs]]
contract_address = "${voter_registry}"
topic = "0x824bc2cc10bfe21ead60b8c8a90716eb325b9335aa73eaede799abf38fce062c"

[[indexer.collect_logs]]
contract_address = "${voter_registry}"
topic = "0xbfb6cd90b6e2668916d9e034926c84f40bcf94094b0d625ec8eecfdeb2150ae1"
