services:
  - name: tee-internal
    privateServiceName: ${name}
    healthcheckPort: 6661
    healthcheckRequestPath: /healthy
    healthCheck:
      checkIntervalSec: 5
      timeoutSec: 4
      successThreshold: 1
      failureThreshold: 2
    routePort: 6661
    routeRules:
      - matches:
          - path:
              type: PathPrefix
              value: /